{
  "expo": {
    "name": "Nest",
    "slug": "template-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nest-icon.png",
    "scheme": "templateexpo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#176B58",
        "foregroundImage": "./assets/images/nest-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/nest-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9F5",
          "image": "./assets/images/nest-splash.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#101C18",
            "image": "./assets/images/nest-splash.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
