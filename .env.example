# Public backend base URL (including your API version prefix).
# Copy to .env.local and replace with your own backend URL.
# Values prefixed EXPO_PUBLIC_ are bundled into the app. Do not put secrets here.
EXPO_PUBLIC_API_URL=https://api.example.com/v1

# Pretty JSON API logs are on by default in Expo development builds.
# Set false to disable them; production builds default to no logging.
EXPO_PUBLIC_API_LOGGING=true
